# ============================================================
# Frontend Environment Variables
# Copy to .env.local (Vite reads this automatically)
# NEVER commit .env.local to version control
# ============================================================
# WHY VITE_ prefix: Vite only exposes env vars with this prefix
# to client-side code (import.meta.env.VITE_*).
# This prevents accidentally leaking server secrets to the browser.
# ============================================================

VITE_API_URL=http://localhost:5000/api/v1
VITE_WS_URL=http://localhost:5000
VITE_APP_NAME=MERN E-Commerce
